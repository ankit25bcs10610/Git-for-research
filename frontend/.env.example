# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Settings -> API). Without these, the waitlist form
# shows a clear "not connected yet" message instead of silently failing.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
